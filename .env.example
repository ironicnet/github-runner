GITHUB_URL=https://github.com/OWNER/REPOSITORY

# Use either a short-lived registration token OR a PAT/fine-grained token
# with permission to manage self-hosted runners for the selected target.
RUNNER_TOKEN=
GITHUB_PAT=
GITHUB_TOKEN=

RUNNER_NAME=
RUNNER_WORKDIR=_work
RUNNER_LABELS=self-hosted,linux,node,pnpm
RUNNER_GROUP=
RUNNER_EPHEMERAL=false
RUNNER_REPLACE=true
RUNNER_DISABLE_UPDATE=false
RUNNER_NO_DEFAULT_LABELS=false

NODE_VERSION=22
PNPM_VERSION=10.17.1
